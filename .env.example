# Copy to .env for local development. Never commit .env.
# Names only; fill values locally or in the host's secret store.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/circletube
SESSION_SECRET=

# AI follower replies (server boots without it; replies fail)
OPENAI_API_KEY=

# Optional
PORT=5000
WS_ALLOWED_ORIGINS=
BASE_URL=

# NFT features stay off unless NFT_MINT_ENABLED is exactly "true" with a signing key set.
# Leave both unset.
NFT_MINT_ENABLED=
ETH_PROVIDER_URL=
