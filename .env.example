# Copy to .env for local development. Never commit .env.
# Names only; fill values locally or in the host's secret store.

# Required
# Neon Postgres connection string (the server uses Neon's WebSocket driver)
DATABASE_URL=
# Generate locally, e.g. `openssl rand -hex 32`. Production refuses an empty value.
SESSION_SECRET=
# Needed for the server to start; used for AI follower replies
OPENAI_API_KEY=

# Optional
PORT=5000
WS_ALLOWED_ORIGINS=
BASE_URL=

# NFT features stay off unless NFT_MINT_ENABLED is exactly "true" AND
# ETH_PRIVATE_KEY is set. Leave both unset; do not add a key here.
NFT_MINT_ENABLED=
# ETH_PRIVATE_KEY=
ETH_PROVIDER_URL=
